fn multiple_uses() {
    let is_active = true;
    let _a = is_active;
    let _b = is_active;
    let _c = is_active;
}

fn closure_use() -> usize {
    let is_enabled = true;
    let values = [1, 2, 3];
    values.iter().filter(|_| is_enabled).count()
}

fn async_block_use() {
    let is_ready = true;
    let _future = async move { is_ready };
}

struct Flags {
    visible: bool,
}

fn shorthand_field_use() -> bool {
    let is_visible = true;
    let flags = Flags { visible: is_visible };
    flags.visible
}

fn main() {
    multiple_uses();
    let _ = closure_use();
    async_block_use();
    let _ = shorthand_field_use();
}
