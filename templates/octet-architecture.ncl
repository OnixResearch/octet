# Copy this file and `octet-architecture.contracts.ncl` to the workspace root.
# Start with inventory mode. Replace every example package, scope, target, and rule.
# Export after review:
#   nickel export --format json octet-architecture.ncl > octet-architecture.json
let contracts = import "./octet-architecture.contracts.ncl" in
{
  schema_version = "octet-project-architecture-policy/v1",
  project_id = "replace-with-project-id",
  mode = "inventory",
  production = {
    packages = ["domain", "application", "inbound", "outbound", "host"],
    source_scopes = [
      "crates/domain/src",
      "crates/application/src",
      "crates/inbound/src",
      "crates/outbound/src",
      "crates/host/src",
    ],
    targets = [{
      triple = "x86_64-unknown-linux-gnu",
      features = ["production"],
      default_features = false,
    }],
  },
  roles = [
    { scope_kind = "package", scope = "domain", role = "domain-core" },
    { scope_kind = "package", scope = "application", role = "application-shell" },
    { scope_kind = "package", scope = "inbound", role = "inbound-adapter" },
    { scope_kind = "package", scope = "outbound", role = "outbound-adapter" },
    { scope_kind = "package", scope = "host", role = "composition-root" },
    { scope_kind = "source", scope = "crates/domain/src", role = "domain-core" },
    { scope_kind = "source", scope = "crates/application/src", role = "application-shell" },
    { scope_kind = "source", scope = "crates/inbound/src", role = "inbound-adapter" },
    { scope_kind = "source", scope = "crates/outbound/src", role = "outbound-adapter" },
    { scope_kind = "source", scope = "crates/host/src", role = "composition-root" },
    { scope_kind = "source", scope = "tests", role = "test" },
    { scope_kind = "source", scope = "target/generated", role = "generated" },
  ],
  dependency_rules = [
    {
      caller_role = "domain-core",
      allowed_callee_roles = ["domain-core"],
      edge_kinds = ["normal", "build"],
    },
    {
      caller_role = "application-shell",
      allowed_callee_roles = ["application-shell", "domain-core"],
      edge_kinds = ["normal", "build"],
    },
    {
      caller_role = "inbound-adapter",
      allowed_callee_roles = ["inbound-adapter", "application-shell"],
      edge_kinds = ["normal", "build"],
    },
    {
      caller_role = "outbound-adapter",
      allowed_callee_roles = ["outbound-adapter", "application-shell"],
      edge_kinds = ["normal", "build"],
    },
    {
      caller_role = "composition-root",
      allowed_callee_roles = [
        "composition-root",
        "application-shell",
        "inbound-adapter",
        "outbound-adapter",
      ],
      edge_kinds = ["normal", "build"],
    },
  ],
  provider_classifications = [
    {
      package = "serde",
      kind = "pure-value",
      permitted_caller_roles = ["domain-core", "application-shell"],
      edge_kinds = ["normal"],
      rationale = "reviewed deterministic value provider",
    },
    {
      package = "sqlx",
      kind = "infrastructure",
      permitted_caller_roles = ["outbound-adapter", "composition-root"],
      edge_kinds = ["normal"],
      rationale = "storage infrastructure remains outside inward contracts",
    },
  ],
  ports = [{
    port_trait = "application::ports::Repository",
    application_owner_scope = "crates/application/src",
    permitted_adapter_scopes = ["crates/outbound/src"],
    forbidden_concrete_types = ["sqlx::", "diesel::"],
    reserved = false,
  }],
  capability_classifications = [
    {
      family = "time",
      core_handling = "explicit-fact",
      executor_role = "outbound-adapter",
      rationale = "the shell observes time before domain evaluation",
    },
    {
      family = "filesystem",
      core_handling = "effect-plan",
      executor_role = "outbound-adapter",
      rationale = "the domain returns a plan and an adapter performs filesystem work",
    },
  ],
  outbound_effects = [
    {
      family = "filesystem",
      executor_scope = "crates/outbound/src",
      executor_methods = ["outbound::FilesystemPort::publish"],
      authority = "protected",
      rationale = "publication requires an application-owned authority decision",
      protected = {
        decision_scope = "crates/domain/src",
        witness_owner_scope = "crates/domain/src",
        receipt_scope = "crates/application/src",
        authority_input_types = ["domain::ActorAuthority"],
        decision_functions = ["domain::authorize_publication"],
        authorized_output_types = ["domain::AuthorizedPublication"],
        witness_type = "domain::PublicationAuthority",
        witness_constructors = ["domain::PublicationAuthority::from_decision"],
        witness_binding_types = ["domain::PublicationPlanId"],
        plan_type = "domain::PublicationPlan",
        attempt_type = "application::PublicationAttempt",
        observed_outcome_type = "application::PublicationObservation",
        receipt_type = "application::PublicationReceipt",
        receipt_constructors = ["application::PublicationReceipt::from_observation"],
        failure_receipt_constructors = ["application::PublicationReceipt::from_failure"],
        success_observation_constructors = ["application::PublicationObservation::success"],
        failure_observation_constructors = ["application::PublicationObservation::failure"],
        witness_use = "consume",
        borrow_scope = null,
        borrow_rationale = null,
        non_claims = [
          "credential-validity",
          "revocation-freshness",
          "actor-trust",
          "business-policy-correctness",
          "external-execution-success",
          "receipt-authenticity",
        ],
      },
    },
  ],
  core_no_std = [{ scope = "domain" }],
  admission = null,
  waivers = [],
  collection_limits = {
    max_units = 32,
    max_shards = 32,
    max_modules = 4096,
    max_items = 65536,
    max_types = 65536,
    max_traits = 8192,
    max_implementations = 16384,
    max_signatures = 65536,
    max_calls = 262144,
    max_constructors = 65536,
    max_effects = 65536,
    max_expansions = 65536,
    max_configurations = 8192,
    max_type_shapes = 65536,
    max_function_safety_facts = 65536,
    max_value_provenance_facts = 262144,
    max_value_flow_bodies = 65536,
    max_value_flow_steps = 1048576,
    max_value_flow_rounds = 64,
    max_unknowns = 65536,
    max_spans = 262144,
    max_span_bytes = 1048576,
    max_shard_bytes = 67108864,
    max_artifact_bytes = 268435456,
  },
  non_claims = [
    "complete-fcis-proof",
    "complete-hexagonal-proof",
    "runtime-determinism",
    "whole-program-correctness",
    "release-eligibility",
  ],
} | contracts.ProjectArchitecturePolicy | contracts.ProjectArchitecturePolicyRules
