# Typed starter profile registry for optional dynamic evidence rails.
# Export with: nickel export --format json templates/dynamic-evidence-profiles.ncl

let NonEmptyString = std.contract.from_predicate (fun value => std.is_string value && std.string.length value > 0) in
let PositiveNumber = std.contract.from_predicate (fun value => std.is_number value && value > 0) in
let Timing = std.contract.from_predicate (fun value => std.array.elem value [
  "after-big-change",
  "focused-ci",
  "nightly",
  "pre-release",
  "suspected-bug",
]) in
let DynamicEvidenceProfile = {
  name | NonEmptyString,
  risk_class | NonEmptyString,
  tool | NonEmptyString,
  timing | Timing,
  allowed_commands | Array NonEmptyString,
  expected_signal | NonEmptyString,
  not_default | Bool | default = true,
  non_claim | NonEmptyString,
} in
let CargoFuzzProfile = {
  name | std.contract.from_predicate (fun value => value == "cargo-fuzz-libfuzzer"),
  engine | std.contract.from_predicate (fun value => value == "libfuzzer"),
  target | std.contract.from_predicate (fun value => value == "octet-profile-intake"),
  toolchain | std.contract.from_predicate (fun value => value == "nightly-2026-03-21"),
  compiler_identity | NonEmptyString,
  sanitizer | std.contract.from_predicate (fun value => value == "address"),
  command_argv | Array NonEmptyString,
  max_total_time_seconds | PositiveNumber,
  max_runs | PositiveNumber,
  seed | PositiveNumber,
  corpus_dir | NonEmptyString,
  artifact_dir | NonEmptyString,
  dictionary_path | String,
  hash_only_corpus | Bool,
  max_artifact_count | PositiveNumber,
  max_artifact_bytes | PositiveNumber,
  max_path_bytes | PositiveNumber,
  max_log_bytes | PositiveNumber,
  evidence_tier | std.contract.from_predicate (fun value => value == "transcript_assertion"),
  non_claims | Array NonEmptyString,
} in
{
  schema_version = "octet-dynamic-evidence-profiles/v1",
  profiles = [
    {
      name = "miri-unsafe-boundary",
      risk_class = "unsafe-boundary undefined-behavior smoke",
      tool = "cargo miri",
      timing = "pre-release",
      allowed_commands = ["cargo miri test"],
      expected_signal = "passed",
      not_default = true,
      non_claim = "Miri evidence covers the selected interpreter workload only and is not a whole-program correctness proof.",
    },
    {
      name = "loom-concurrency",
      risk_class = "bounded concurrency schedule exploration",
      tool = "cargo test with loom cfg",
      timing = "suspected-bug",
      allowed_commands = ["cargo test --cfg loom"],
      expected_signal = "passed",
      not_default = true,
      non_claim = "Loom evidence covers the selected model and bounds only and is not exhaustive runtime verification.",
    },
    {
      name = "cargo-fuzz-libfuzzer",
      risk_class = "bounded coverage-guided crash discovery",
      tool = "cargo-fuzz with libFuzzer",
      timing = "focused-ci",
      allowed_commands = ["cargo fuzz run octet-profile-intake -- -max_total_time=60 -runs=100000 -seed=1"],
      expected_signal = "clean",
      not_default = true,
      non_claim = "Cargo-fuzz evidence covers one selected target and bounded run only.",
    },
  ],
  cargo_fuzz_profiles = [
    {
      name = "cargo-fuzz-libfuzzer",
      engine = "libfuzzer",
      target = "octet-profile-intake",
      toolchain = "nightly-2026-03-21",
      compiler_identity = "nix:fenix-nightly-2026-03-21-x86_64-unknown-linux-gnu",
      sanitizer = "address",
      command_argv = [
        "cargo",
        "fuzz",
        "run",
        "octet-profile-intake",
        "--",
        "-max_total_time=60",
        "-runs=100000",
        "-seed=1",
      ],
      max_total_time_seconds = 60,
      max_runs = 100000,
      seed = 1,
      corpus_dir = "fuzz/corpus/octet-profile-intake",
      artifact_dir = "fuzz/artifacts/octet-profile-intake",
      dictionary_path = "",
      hash_only_corpus = true,
      max_artifact_count = 128,
      max_artifact_bytes = 16777216,
      max_path_bytes = 240,
      max_log_bytes = 1048576,
      evidence_tier = "transcript_assertion",
      non_claims = [
        "Cargo-fuzz evidence covers one target, seed, corpus, sanitizer, and bounded run; it is not exhaustive coverage, memory-safety proof, panic-freedom proof, or release eligibility.",
        "A clean bounded run does not prove that undiscovered crashes do not exist.",
      ],
    },
  ],
} | {
  schema_version | std.contract.from_predicate (fun value => value == "octet-dynamic-evidence-profiles/v1"),
  profiles | Array DynamicEvidenceProfile,
  cargo_fuzz_profiles | Array CargoFuzzProfile,
}
