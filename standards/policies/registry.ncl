let contracts = import "contracts.ncl" in
let PolicyRegistry = contracts.PolicyRegistry in
let PolicyRegistryRules = contracts.PolicyRegistryRules in

let hard_suppression = {
  requires_policy_id = true,
  requires_source_section = true,
  requires_owner = true,
  requires_rationale = true,
  requires_review_trigger = true,
  requires_safer_default = true,
}
in

let advisory_suppression = {
  requires_policy_id = true,
  requires_source_section = true,
  requires_owner = false,
  requires_rationale = true,
  requires_review_trigger = false,
  requires_safer_default = false,
}
in

let human_suppression = {
  requires_policy_id = false,
  requires_source_section = false,
  requires_owner = false,
  requires_rationale = false,
  requires_review_trigger = false,
  requires_safer_default = false,
}
in

let default_fixture_coverage = fun classification =>
  if classification == "hard" then
    {
      status = "planned",
      compliant = [],
      noncompliant = [],
    }
  else
    {
      status = "not-applicable",
      compliant = [],
      noncompliant = [],
    }
in

let default_evidence = fun classification =>
  if classification == "hard" then
    [
      "compliant fixture",
      "noncompliant fixture",
      "diagnostic regression",
    ]
  else if classification == "advisory" then
    [
      "deterministic sample input",
      "stable advisory report",
    ]
  else
    [
      "documented human review rationale",
    ]
in

let default_suppression = fun classification =>
  if classification == "hard" then
    hard_suppression
  else if classification == "advisory" then
    advisory_suppression
  else
    human_suppression
in

let mk_policy = fun entry =>
  {
    suppression_requirements = default_suppression entry.classification,
    fixture_coverage = default_fixture_coverage entry.classification,
    verification_evidence_requirements = default_evidence entry.classification,
    existing_enforcement | default = [],
    custom_checker_justification | default = "existing tools must be preferred; custom checker requires precision and cross-family reuse note",
  }
  & entry
in

