let NonEmpty = std.contract.from_predicate (fun value => std.is_string value && std.string.length value > 0) in
let Positive = std.contract.from_predicate (fun value => std.is_number value && value > 0) in
let Profile = {
  profile_id | NonEmpty,
  driver_name | NonEmpty,
  supported_version | std.contract.from_predicate (fun value => value == "2.1.0"),
  require_rule_id | std.contract.from_predicate (fun value => value == true),
  workspace_relative_only | std.contract.from_predicate (fun value => value == true),
  source_levels | { error | NonEmpty, warning | NonEmpty, note | NonEmpty, none | NonEmpty },
  max_report_bytes | Positive,
  max_runs | Positive,
  max_rules | Positive,
  max_artifacts | Positive,
  max_results | Positive,
  max_locations_per_result | Positive,
  max_message_bytes | Positive,
  max_path_bytes | Positive,
  evidence_tier | std.contract.from_predicate (fun value => value == "static_lint"),
  non_claims | Array NonEmpty,
} in
