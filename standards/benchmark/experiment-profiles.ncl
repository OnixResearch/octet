let matrix = [
  { tool_id = "octet", task_id = "dependency-boundary", status = "supported" },
  { tool_id = "octet", task_id = "reexports-aliases", status = "supported" },
  { tool_id = "octet", task_id = "macro-expansion", status = "supported" },
  { tool_id = "octet", task_id = "conditional-compilation", status = "supported" },
  { tool_id = "octet", task_id = "trait-method-references", status = "supported" },
  { tool_id = "octet", task_id = "workspace-targets", status = "supported" },
  { tool_id = "octet", task_id = "empty-selected-scope", status = "supported" },
  { tool_id = "octet", task_id = "stale-evidence", status = "supported" },
  { tool_id = "octet", task_id = "changed-policy", status = "supported" },
  { tool_id = "octet", task_id = "missing-execution", status = "supported" },
  { tool_id = "octet", task_id = "invalid-proof-source-linkage", status = "supported" },
  { tool_id = "cargo-pup", task_id = "dependency-boundary", status = "supported" },
  { tool_id = "cargo-pup", task_id = "reexports-aliases", status = "supported" },
  { tool_id = "cargo-pup", task_id = "trait-method-references", status = "supported" },
  { tool_id = "cargo-pup", task_id = "workspace-targets", status = "supported" },
  { tool_id = "cargo-pup", task_id = "empty-selected-scope", status = "supported" },
  { tool_id = "archunit-rust", task_id = "dependency-boundary", status = "supported" },
  { tool_id = "archunit-rust", task_id = "reexports-aliases", status = "supported" },
  { tool_id = "archunit-rust", task_id = "trait-method-references", status = "supported" },
  { tool_id = "archunit-rust", task_id = "workspace-targets", status = "supported" },
  { tool_id = "archunit-rust", task_id = "empty-selected-scope", status = "supported" },
  { tool_id = "semgrep", task_id = "dependency-boundary", status = "partial" },
  { tool_id = "semgrep", task_id = "reexports-aliases", status = "partial" },
  { tool_id = "codeql", task_id = "dependency-boundary", status = "partial" },
  { tool_id = "codeql", task_id = "reexports-aliases", status = "partial" },
  { tool_id = "repository-baseline-script", task_id = "dependency-boundary", status = "partial" },
  { tool_id = "repository-baseline-script", task_id = "reexports-aliases", status = "partial" },
  { tool_id = "repository-baseline-script", task_id = "stale-evidence", status = "partial" },
  { tool_id = "repository-baseline-script", task_id = "changed-policy", status = "partial" },
] in

let status_for = fun tool_id task_id =>
  let matches = matrix |> std.array.filter (fun entry => entry.tool_id == tool_id && entry.task_id == task_id) in
  if std.array.length matches == 0 then "unsupported" else (std.array.first matches).status
in

let case_ids_for = fun task_id =>
  corpus_cases |> std.array.filter (fun case => case.task_id == task_id) |> std.array.map (fun case => case.case_id)
in

let rationale_for = fun tool_id task_id status =>
  if status == "unsupported" then
    "The published applicability matrix does not declare this tool for task `" ++ task_id ++ "`."
  else
    "Declared by the frozen applicability matrix for tool `" ++ tool_id ++ "` and task `" ++ task_id ++ "`."
in

let applicability_entries = std.array.flat_map (fun tool =>
  std.array.map (fun task =>
    let selected_status = status_for tool.tool_id task.task_id in
    {
      task_id = task.task_id,
      tool_id = tool.tool_id,
      status = selected_status,
      case_ids = if selected_status == "unsupported" then [] else case_ids_for task.task_id,
      comparable_subset = task.comparable_subset,
      scope = task.required_scope,
      rationale = rationale_for tool.tool_id task.task_id selected_status,
    }
   ) task_definitions
) tool_definitions in

let adoption_tool_plans = std.array.map (fun tool => {
  tool_id = tool.tool_id,
  setup_steps = tool.setup_steps,
  required_config_files = tool.required_config_files,
  initial_command = if std.array.length tool.run_argv == 0 then tool.probe_argv else tool.run_argv,
  incremental_command = if std.array.length tool.run_argv == 0 then tool.probe_argv else tool.run_argv,
  unavailable_metrics = [
    "cpu_time_ns",
    "peak_memory_bytes",
    "network_install_time_ms",
  ],
} ) tool_definitions in

{
  schema_version = "octet-benchmark-experiment-profiles/v1",
  profiles = [
    {
      profile_id = "octet-cross-tool-architecture-v1",
      source_revision = "github:OnixResearch/octet@2bdd581980eef7f6ec8363ffa20ab9f3c798c9ee",
      rust_toolchain = "nightly-2026-03-21",
      evidence_tier = "transcript_assertion",
      declared_before_measurement = true,
      corpus = corpus_cases,
      tasks = task_definitions,
      tools = tool_definitions,
      applicability = applicability_entries,
      adoption = {
        clean_consumer = {
          selection_id = "clean-consumer-architecture-corpus-v1",
          source_repository = "github:OnixResearch/octet",
          source_revision = "2bdd581980eef7f6ec8363ffa20ab9f3c798c9ee",
          workspace_path = "standards/benchmark/corpus",
          immutable = true,
          notes = "The checked-in corpus is dependency-free and bounded to the declared architecture cases.",
        },
        real_consumer = {
          selection_id = "bounded-exec-44eb74e",
