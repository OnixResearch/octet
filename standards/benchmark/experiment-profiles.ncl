# Cross-tool architecture, assurance, and adoption benchmark profile.
#
# This file is the predeclared experiment contract. It is exported to
# experiment-profiles.json before any candidate output is read. The Rust
# evaluator consumes the generated JSON; it never accepts an inline matrix.
let NonEmpty = std.contract.from_predicate (fun value => std.is_string value && std.string.length value > 0) in
let Positive = std.contract.from_predicate (fun value => std.is_number value && value > 0) in
let OneOf = fun allowed => std.contract.from_predicate (fun value =>
  std.is_string value && std.array.elem value allowed
) in

let Category = OneOf ["architecture", "assurance"] in
let Variant = OneOf ["compliant", "violating", "control", "empty_scope", "disputed"] in
let Expected = OneOf ["finding", "clean", "empty_scope", "disputed", "unsupported"] in
let ToolKind = OneOf [
  "compiler-lint",
  "crate-lint",
  "library",
  "scanner",
  "supply-chain",
  "lint-driver",
  "repository-script",
] in
let Execution = OneOf ["recorded", "probe", "invoke"] in
let Parser = OneOf ["none"] in
let ApplicabilityStatus = OneOf ["supported", "partial", "unsupported"] in

let Case = {
  case_id | NonEmpty,
  task_id | NonEmpty,
  category | Category,
  variant | Variant,
  source_path | NonEmpty,
  source_identity | NonEmpty,
  scope | {
    selected_sources | Array NonEmpty,
    expected_analyzed_sources | std.number.Nat,
    empty | Bool,
  },
  expected | Expected,
  rationale | NonEmpty,
  reviewer_role | NonEmpty,
} in
let Task = {
  task_id | NonEmpty,
  category | Category,
  description | NonEmpty,
  comparable_subset | NonEmpty,
  required_scope | NonEmpty,
} in
let Tool = {
  tool_id | NonEmpty,
  kind | ToolKind,
  executable | NonEmpty,
  version_pin | NonEmpty,
  source_pin | NonEmpty,
  config_path | Array NonEmpty,
  config_identity | Array NonEmpty,
  configuration_status | OneOf ["checked-in", "upstream-args", "not-installed"],
  rules_pin | NonEmpty,
  probe_argv | Array NonEmpty,
  run_argv | Array NonEmpty,
  execution | Execution,
  parser | Parser,
  setup_source | NonEmpty,
  setup_steps | Array NonEmpty,
  required_config_files | Array NonEmpty,
  claims | Array NonEmpty,
} in
let Applicability = {
  task_id | NonEmpty,
  tool_id | NonEmpty,
  status | ApplicabilityStatus,
  case_ids | Array NonEmpty,
  comparable_subset | NonEmpty,
  scope | NonEmpty,
  rationale | NonEmpty,
} in
let AdoptionTarget = {
  selection_id | NonEmpty,
  source_repository | NonEmpty,
  source_revision | NonEmpty,
  workspace_path | NonEmpty,
  immutable | Bool,
  notes | NonEmpty,
} in
let AdoptionTool = {
  tool_id | NonEmpty,
  setup_steps | Array NonEmpty,
  required_config_files | Array NonEmpty,
  initial_command | Array NonEmpty,
  incremental_command | Array NonEmpty,
  unavailable_metrics | Array NonEmpty,
} in
let Profile = {
  profile_id | NonEmpty,
  source_revision | NonEmpty,
  rust_toolchain | NonEmpty,
  evidence_tier | OneOf ["transcript_assertion"],
  declared_before_measurement | Bool,
  corpus | Array Case,
  tasks | Array Task,
  tools | Array Tool,
  applicability | Array Applicability,
  adoption | {
    clean_consumer | AdoptionTarget,
    real_consumer | AdoptionTarget,
    tools | Array AdoptionTool,
  },
  sample_plan | {
    warm_state | OneOf ["cold"],
    cache_state | OneOf ["cold"],
    target | NonEmpty,
    sample_count | Positive,
    timeout_ms | Positive,
    environment_facts | Array NonEmpty,
    dependency_differences | Array NonEmpty,
    unavailable_metrics | Array NonEmpty,
  },
  negative_controls | Array { control_id | NonEmpty, description | NonEmpty },
  coverage_boundary | {
    corpus_id | NonEmpty,
    bounded | Bool,
    complete_rust_coverage | Bool,
    statement | NonEmpty,
  },
  non_claims | Array NonEmpty,
} in

let b3 = fun hex => "b3:" ++ hex in

