let task_definitions = [
  {
    task_id = "dependency-boundary",
    category = "architecture",
    description = "Application-shell code may not reach core internals or construct outbound adapters.",
    comparable_subset = "architecture-dependency-boundary-v1",
    required_scope = "selected source file and its declared crate role",
  },
  {
    task_id = "reexports-aliases",
    category = "architecture",
    description = "Public reexports and aliases may expose core ports but not adapter internals.",
    comparable_subset = "architecture-reexports-aliases-v1",
    required_scope = "selected source file and its public item graph",
  },
  {
    task_id = "macro-expansion",
    category = "architecture",
    description = "Macro expansion may not hide a forbidden dependency or construction.",
    comparable_subset = "architecture-macro-expansion-v1",
    required_scope = "selected source file and expansion-aware call graph",
  },
  {
    task_id = "conditional-compilation",
    category = "architecture",
    description = "Cfg-selected branches must be attributed to the analyzed feature configuration.",
    comparable_subset = "architecture-conditional-compilation-v1",
    required_scope = "selected source file plus the declared feature and target configuration",
  },
  {
    task_id = "trait-method-references",
    category = "architecture",
    description = "Trait and inherent method references are resolved to the defining type or trait.",
    comparable_subset = "architecture-trait-method-references-v1",
    required_scope = "selected source file and resolved method definitions",
  },
  {
    task_id = "workspace-targets",
    category = "architecture",
    description = "Every selected workspace target is analyzed with the same dependency rule.",
    comparable_subset = "architecture-workspace-targets-v1",
    required_scope = "declared target list including binaries",
  },
  {
    task_id = "empty-selected-scope",
    category = "architecture",
    description = "An empty selection is neither clean evidence nor a false negative.",
    comparable_subset = "architecture-empty-selected-scope-v1",
    required_scope = "zero selected Rust files",
  },
  {
    task_id = "stale-evidence",
    category = "assurance",
    description = "Retained evidence identities must still match the claim and the checked policy.",
    comparable_subset = "assurance-stale-evidence-v1",
    required_scope = "retained evidence file and checked policy identity",
  },
  {
    task_id = "changed-policy",
    category = "assurance",
    description = "Evidence admitted under a different policy identity is rejected.",
    comparable_subset = "assurance-changed-policy-v1",
    required_scope = "recorded and checked policy identities",
  },
  {
    task_id = "missing-execution",
    category = "assurance",
    description = "A claim without an observed execution is rejected.",
    comparable_subset = "assurance-missing-execution-v1",
    required_scope = "execution status and command identity",
  },
  {
    task_id = "invalid-proof-source-linkage",
    category = "assurance",
    description = "Proof artifacts must link to the source bytes the claim names.",
    comparable_subset = "assurance-invalid-proof-source-linkage-v1",
    required_scope = "proof source identity and claimed source identity",
  },
] in

