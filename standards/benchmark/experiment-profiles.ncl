          source_revision = "44eb74eb639194665ee820562d5b2ce2c3ff6a94",
          workspace_path = "not-checked-out-in-benchmark-environment",
          immutable = true,
          notes = "Immutable real consumer selection. Runtime is unavailable in this benchmark environment; no timing is invented.",
        },
        tools = adoption_tool_plans,
      },
      sample_plan = {
        warm_state = "cold",
        cache_state = "cold",
        target = "x86_64-unknown-linux-gnu",
        sample_count = 1,
        timeout_ms = 30000,
        environment_facts = [
          "host_os",
          "host_arch",
          "rust_toolchain",
          "tool_version",
          "cache_state",
        ],
        dependency_differences = [
          "cargo-pup and ArchUnitRust require their own pinned crates; Octet runs from the pinned workspace build.",
          "Semgrep and CodeQL are unavailable in this environment, so their runtime rows stay unavailable.",
          "cargo-vet is unavailable and cargo-deny is unusable in the current shell; neither is counted as clean.",
        ],
        unavailable_metrics = ["cpu_time_ns", "peak_memory_bytes", "network_install_time_ms"],
      },
      negative_controls = [
        { control_id = "noncompiling-violation-counted-as-detection", description = "A violating case that did not compile must not become a detection." },
        { control_id = "renamed-stale-oracle", description = "An observation whose case or source identity no longer matches the frozen oracle must be rejected." },
        { control_id = "differing-scope-hidden", description = "An observation with a different analyzed scope must not enter comparable metrics." },
        { control_id = "dropped-timeouts", description = "Removing a timed-out observation must surface missing execution instead of clean evidence." },
        { control_id = "stale-results", description = "A derived comparison that does not reproduce from retained inputs must be rejected." },
        { control_id = "hidden-toolchain-cache-difference", description = "A differing toolchain or cache identity must be surfaced, not merged." },
        { control_id = "unsupported-counted-clean", description = "Unsupported scope must not increment clean evidence or true negatives." },
        { control_id = "bounded-corpus-presented-as-complete", description = "The artifact must reject a complete-Rust-coverage claim for the bounded corpus." },
      ],
      coverage_boundary = {
        corpus_id = "octet-benchmark-architecture-corpus-v1",
        bounded = true,
        complete_rust_coverage = false,
        statement = "The corpus is a small compiling fixture with declared compliant, violating, disputed, and empty-scope cases; it is not a complete Rust program or a representative sample of Rust projects.",
      },
      non_claims = [
        "The experiment is bounded fixture evidence; it does not prove correctness, universal detection, complete Rust coverage, or release eligibility.",
        "The experiment does not prove correctness, universal detection, or release eligibility.",
        "Fixture observations are recorded evidence, not a claim that every candidate executable ran in this environment.",
        "Unavailable tools remain unsupported; their absence is not clean evidence.",
        "The bounded corpus is not complete Rust coverage and precision/recall apply only to declared comparable subsets.",
      ],
    },
  ],
} | {
  schema_version | std.contract.from_predicate (fun value => value == "octet-benchmark-experiment-profiles/v1"),
  profiles | Array Profile,
}
