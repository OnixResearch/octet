let Fixture = {
  fixture_id | String,
  path | String,
  source_identity | String,
  bytes | Number,
  property_class | String,
  expected_observation | String,
  supported | Bool,
  unsupported_reason | String,
}
in
let Criterion = {
  criterion_id | String,
  required | Bool,
  threshold | Number,
}
in
