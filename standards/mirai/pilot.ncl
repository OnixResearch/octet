  profile_id | String,
  provider | {
    repository | String,
    revision | String,
    source_hash | String,
    license | String,
    version | String,
    rust_toolchain | String,
    target | String,
    features | Array String,
    derivation_attr | String,
    derivation_name | String,
    closure_components | Array String,
    command_argv | Array String,
    environment | Array String,
  },
  output_contract | {
    status | String,
    reason_code | String,
    stable_machine_schema | Bool,
  },
  corpus | Array Fixture,
  limits | {
    max_fixtures | Number,
    max_source_bytes | Number,
    timeout_ms | Number,
    max_log_bytes | Number,
  },
  comparison_outcomes | Array String,
  comparison_parents | {
    charon_profile | String,
    source_token_catalog | String,
  },
  decision_states | Array String,
  promotion_criteria | Array Criterion,
  evidence_tier | String,
  verification_role | String,
  non_claims | Array String,
}
