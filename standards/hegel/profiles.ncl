let Profile = {
  profile_id | String,
  family | String,
  producer | {
    package | String,
    package_version | String,
    binary_target | String,
    hegel_version | String,
    backend | String,
  },
  command_argv | Array String,
  property_catalog | String,
  output_root | String,
  summary_path | String,
  counterexample_path | String,
  source_scope | Array String,
  generator_inputs | Array String,
  settings | {
    case_budget | Number,
    phases | Array String,
    seed_posture | String,
    derandomized | Bool,
  },
  limits | {
    max_summary_bytes | Number,
    max_counterexample_bytes | Number,
    max_log_bytes | Number,
    max_source_files | Number,
    max_generator_files | Number,
    max_issue_codes | Number,
    timeout_ms | Number,
    poll_interval_ms | Number,
    teardown_timeout_ms | Number,
  },
  retention | {
    retain_summary | Bool,
    retain_logs | Bool,
    retain_counterexample | Bool,
    redaction | String,
  },
  evidence_tier | String,
  verification_role | String,
  non_claims | Array String,
}
in
let base_producer = {
  package = "cargo-octet",
  package_version = "0.1.1-rc.1",
  binary_target = "lib-test",
  hegel_version = "0.14.27",
  backend = "native",
}
in
let base_settings = {
  case_budget = 64,
  phases = ["generate", "shrink"],
  seed_posture = "derandomized",
  derandomized = true,
}
in
let base_limits = {
  max_summary_bytes = 262144,
  max_counterexample_bytes = 65536,
  max_log_bytes = 1048576,
  max_source_files = 8,
  max_generator_files = 4,
  max_issue_codes = 32,
  timeout_ms = 120000,
  poll_interval_ms = 25,
  teardown_timeout_ms = 5000,
}
in
let base_retention = {
  retain_summary = true,
  retain_logs = true,
  retain_counterexample = true,
  redaction = "issue-codes-and-bounded-values",
}
in
let base_non_claims = [
  "Hegel checks bounded generated inputs only and does not prove correctness, semantic equivalence, verifier soundness, requirement satisfaction, release eligibility, or whole-program safety",
  "The selected law catalog covers only named pure Octet cores and declared generators",
  "A passing bounded run does not establish exhaustive input coverage",
]
in
let mk_command = fun adapter => [
  "cargo",
  "test",
  "--locked",
  "-p",
  "cargo-octet",
  "--lib",
  adapter,
  "--",
  "--exact",
  "--nocapture",
  "--test-threads",
  "1",
]
in
{
  schema_version = "octet-hegel-producer-profiles/v1",
  profiles = [
    {
      profile_id = "octet-pure-core-laws-v1",
      family = "pure_core",
      producer = base_producer,
      command_argv = mk_command "hegel::tests::hegel_profile_adapter",
      property_catalog = "octet-hegel-law-catalog/v1",
      output_root = ".octet/hegel-run",
      summary_path = ".octet/hegel-run/summary.json",
      counterexample_path = ".octet/hegel-run/counterexample.json",
      source_scope = [
        "cargo-octet/src/hegel/mod.rs",
        "cargo-octet/src/hegel/tests.rs",
        "cargo-octet/src/hegel/validation.rs",
      ],
      generator_inputs = [
        "standards/hegel/laws.ncl",
      ],
      settings = base_settings,
      limits = base_limits,
      retention = base_retention,
      evidence_tier = "transcript_assertion",
      verification_role = "recorded_only",
      non_claims = base_non_claims,
    } | Profile,
    {
      profile_id = "octet-evidence-identity-laws-v1",
      family = "identity",
      producer = base_producer,
      command_argv = mk_command "hegel::tests::identity_profile_adapter",
      property_catalog = "octet-hegel-law-catalog/v1",
      output_root = ".octet/hegel-run",
      summary_path = ".octet/hegel-run/summary.json",
      counterexample_path = ".octet/hegel-run/counterexample.json",
      source_scope = [
        "cargo-octet/src/hegel/mod.rs",
        "cargo-octet/src/hegel/validation.rs",
        "cargo-octet/src/roadmap.rs",
        "cargo-octet/src/effect_closure.rs",
        "cargo-octet/src/envelope/mod.rs",
      ],
      generator_inputs = [
        "standards/hegel/laws.ncl",
        "standards/hegel/profiles.ncl",
      ],
      settings = base_settings,
      limits = base_limits,
      retention = base_retention,
      evidence_tier = "transcript_assertion",
      verification_role = "recorded_only",
      non_claims = base_non_claims,
    } | Profile,
    {
      profile_id = "octet-evidence-lineage-laws-v1",
      family = "lineage",
      producer = base_producer,
      command_argv = mk_command "hegel::tests::lineage_profile_adapter",
      property_catalog = "octet-hegel-law-catalog/v1",
      output_root = ".octet/hegel-run",
      summary_path = ".octet/hegel-run/summary.json",
      counterexample_path = ".octet/hegel-run/counterexample.json",
      source_scope = [
        "cargo-octet/src/evidence_multihop.rs",
        "cargo-octet/src/roadmap.rs",
        "cargo-octet/src/hegel/mod.rs",
      ],
      generator_inputs = [
        "standards/hegel/laws.ncl",
        "standards/hegel/profiles.ncl",
      ],
      settings = base_settings,
      limits = base_limits,
      retention = base_retention,
      evidence_tier = "transcript_assertion",
      verification_role = "recorded_only",
      non_claims = base_non_claims,
    } | Profile,
    {
      profile_id = "octet-catalog-composition-laws-v1",
      family = "catalog_composition",
      producer = base_producer,
      command_argv = mk_command "hegel::tests::catalog_profile_adapter",
      property_catalog = "octet-hegel-law-catalog/v1",
      output_root = ".octet/hegel-run",
      summary_path = ".octet/hegel-run/summary.json",
      counterexample_path = ".octet/hegel-run/counterexample.json",
      source_scope = [
        "cargo-octet/src/effect_closure.rs",
        "cargo-octet/src/hegel/profile_validation.rs",
        "cargo-octet/src/hegel/mod.rs",
      ],
      generator_inputs = [
        "standards/hegel/laws.ncl",
        "standards/hegel/profiles.ncl",
      ],
      settings = base_settings,
      limits = base_limits,
      retention = base_retention,
      evidence_tier = "transcript_assertion",
      verification_role = "recorded_only",
      non_claims = base_non_claims,
    } | Profile,
    {
      profile_id = "octet-reduction-acceptance-laws-v1",
      family = "reduction_acceptance",
      producer = base_producer,
      command_argv = mk_command "hegel::tests::reduction_profile_adapter",
      property_catalog = "octet-hegel-law-catalog/v1",
      output_root = ".octet/hegel-run",
      summary_path = ".octet/hegel-run/summary.json",
      counterexample_path = ".octet/hegel-run/counterexample.json",
      source_scope = [
        "cargo-octet/src/proof_ref.rs",
        "cargo-octet/src/proof_candidates.rs",
        "cargo-octet/src/roadmap.rs",
        "cargo-octet/src/hegel/mod.rs",
      ],
      generator_inputs = [
        "standards/hegel/laws.ncl",
        "standards/hegel/profiles.ncl",
      ],
      settings = base_settings,
      limits = base_limits,
      retention = base_retention,
      evidence_tier = "transcript_assertion",
      verification_role = "recorded_only",
      non_claims = base_non_claims,
    } | Profile,
    {
      profile_id = "octet-requirement-admission-laws-v1",
      family = "requirement_admission",
      producer = base_producer,
      command_argv = mk_command "hegel::tests::admission_profile_adapter",
      property_catalog = "octet-hegel-law-catalog/v1",
      output_root = ".octet/hegel-run",
      summary_path = ".octet/hegel-run/summary.json",
      counterexample_path = ".octet/hegel-run/counterexample.json",
      source_scope = [
        "cargo-octet/src/requirements.rs",
        "cargo-octet/src/requirements/evaluation/decision.rs",
        "cargo-octet/src/requirements/evaluation/clause.rs",
        "cargo-octet/src/requirements/evaluation/formal.rs",
        "cargo-octet/src/requirements/evaluation/negative.rs",
        "cargo-octet/src/effect_closure.rs",
      ],
      generator_inputs = [
        "standards/hegel/laws.ncl",
        "standards/hegel/profiles.ncl",
      ],
      settings = base_settings,
      limits = base_limits,
      retention = base_retention,
      evidence_tier = "transcript_assertion",
      verification_role = "recorded_only",
      non_claims = base_non_claims,
    } | Profile,
    {
      profile_id = "octet-freshness-mutation-laws-v1",
      family = "freshness",
      producer = base_producer,
      command_argv = mk_command "hegel::tests::freshness_profile_adapter",
      property_catalog = "octet-hegel-law-catalog/v1",
      output_root = ".octet/hegel-run",
      summary_path = ".octet/hegel-run/summary.json",
      counterexample_path = ".octet/hegel-run/counterexample.json",
      source_scope = [
        "cargo-octet/src/requirements/freshness.rs",
        "cargo-octet/src/requirements/related.rs",
        "cargo-octet/src/requirements/evaluation/source.rs",
        "cargo-octet/src/envelope/scan.rs",
        "cargo-octet/src/effect_closure.rs",
      ],
      generator_inputs = [
        "standards/hegel/laws.ncl",
        "standards/hegel/profiles.ncl",
        "standards/hegel/buoy-mutation-matrix.ncl",
      ],
      settings = base_settings,
      limits = base_limits,
      retention = base_retention,
      evidence_tier = "transcript_assertion",
      verification_role = "recorded_only",
      non_claims = base_non_claims,
    } | Profile,
  ],
}
