let Profile = {
  profile_id | String,
  producer | {
    package | String,
    package_version | String,
    binary_target | String,
    hegel_version | String,
    backend | String,
  },
  command_argv | Array String,
  property_catalog | String,
  output_root | String,
  summary_path | String,
  counterexample_path | String,
  source_scope | Array String,
  generator_inputs | Array String,
  settings | {
    case_budget | Number,
    phases | Array String,
    seed_posture | String,
    derandomized | Bool,
  },
  limits | {
    max_summary_bytes | Number,
    max_counterexample_bytes | Number,
    max_log_bytes | Number,
    max_source_files | Number,
    max_generator_files | Number,
    max_issue_codes | Number,
    timeout_ms | Number,
    poll_interval_ms | Number,
    teardown_timeout_ms | Number,
  },
  retention | {
    retain_summary | Bool,
    retain_logs | Bool,
    retain_counterexample | Bool,
    redaction | String,
  },
  evidence_tier | String,
  verification_role | String,
  non_claims | Array String,
}
in
{
  schema_version = "octet-hegel-producer-profiles/v1",
  profiles = [
    {
      profile_id = "octet-pure-core-laws-v1",
      producer = {
        package = "cargo-octet",
        package_version = "0.1.0",
        binary_target = "lib-test",
        hegel_version = "0.14.27",
        backend = "native",
      },
      command_argv = [
        "cargo",
        "test",
        "--locked",
        "-p",
        "cargo-octet",
        "--lib",
        "hegel::tests::hegel_profile_adapter",
        "--",
        "--exact",
        "--nocapture",
        "--test-threads",
        "1",
      ],
      property_catalog = "octet-hegel-law-catalog/v1",
      output_root = ".octet/hegel-run",
      summary_path = ".octet/hegel-run/summary.json",
      counterexample_path = ".octet/hegel-run/counterexample.json",
      source_scope = [
        "cargo-octet/src/hegel/mod.rs",
        "cargo-octet/src/hegel/tests.rs",
        "cargo-octet/src/hegel/validation.rs",
      ],
      generator_inputs = [
        "standards/hegel/laws.ncl",
      ],
      settings = {
        case_budget = 64,
        phases = ["generate", "shrink"],
        seed_posture = "derandomized",
        derandomized = true,
      },
      limits = {
        max_summary_bytes = 262144,
        max_counterexample_bytes = 65536,
        max_log_bytes = 1048576,
        max_source_files = 8,
        max_generator_files = 4,
        max_issue_codes = 32,
        timeout_ms = 120000,
        poll_interval_ms = 25,
        teardown_timeout_ms = 5000,
      },
      retention = {
        retain_summary = true,
        retain_logs = true,
        retain_counterexample = true,
        redaction = "issue-codes-and-bounded-values",
      },
      evidence_tier = "transcript_assertion",
      verification_role = "recorded_only",
      non_claims = [
        "Hegel checks bounded generated inputs only and does not prove correctness, semantic equivalence, verifier soundness, requirement satisfaction, release eligibility, or whole-program safety",
        "The selected law catalog covers only named pure Octet cores and declared generators",
        "A passing bounded run does not establish exhaustive input coverage",
      ],
    } | Profile,
  ],
}
